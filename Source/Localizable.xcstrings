    ".ftsMigrationDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم هذا التحديث بتحسين فهرسة النصوص وتنظيف فواصل الأسطر لضمان دقة البحث في بدايات الفقرات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This update optimizes text indexing and cleans line breaks to ensure accurate search results at the beginning of paragraphs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembaruan ini mengoptimalkan indeks teks dan membersihkan baris baru agar pencarian di awal paragraf lebih akurat."
          }
        }
      }
    },
