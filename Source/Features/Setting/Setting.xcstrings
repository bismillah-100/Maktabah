      "cleanupDownloadedDataBundleMode": {
         "extractionState": "manual",
         "localizations": {
            "ar": {
               "stringUnit": {
                  "state": "translated",
                  "value": "تنظيف البيانات التي تم تنزيلها (وضع الحزمة)"
               }
            },
            "id": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Bersihkan Data yang Diunduh (Mode Bundel)"
               }
            },
            "en": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Cleanup Downloaded Data (Bundle Mode)"
               }
            }
         }
      },
      "cleanupDownloadedDataBundleModeDesc": {
         "extractionState": "manual",
         "localizations": {
            "ar": {
               "stringUnit": {
                  "state": "translated",
                  "value": "سيؤدي هذا إلى حذف جميع ملفات SQLite التي تم تنزيلها، والفهرس، وذاكرة التخزين المؤقت من تخزين وضع الحزمة."
               }
            },
            "id": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Ini akan menghapus semua file SQLite yang diunduh, indeks, dan cache dari penyimpanan mode bundel."
               }
            },
            "en": {
               "stringUnit": {
                  "state": "translated",
                  "value": "This will delete all downloaded SQLite files, index, and cache from the bundle mode storage."
               }
            }
         }
      },
      "cloudKitTokenResetMessage": {
         "extractionState": "manual",
         "localizations": {
            "ar": {
               "stringUnit": {
                  "state": "translated",
                  "value": "تم إعادة تعيين رمز CloudKit. ستبدأ المزامنة الكاملة."
               }
            },
            "id": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Token CloudKit telah diatur ulang. Sinkronisasi penuh akan dimulai."
               }
            },
            "en": {
               "stringUnit": {
                  "state": "translated",
                  "value": "CloudKit token has been reset. Full sync will start."
               }
            }
         }
      },
