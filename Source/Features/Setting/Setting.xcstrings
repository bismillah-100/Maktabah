      "biAnnualRoutineCheckDesc": {
         "extractionState": "manual",
         "localizations": {
            "ar": {
               "stringUnit": {
                  "state": "translated",
                  "value": "فحص دوري نصف سنوي حتى إيقاف المفتاح وإعادة تشغيله."
               }
            },
            "id": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Pemeriksaan rutin setengah tahunan hingga tombol dinonaktifkan dan dinyalakan ulang."
               }
            },
            "en": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Bi-Annual Routine Check until toggled off and on again."
               }
            }
         }
      },
      "bundleMode": {
         "extractionState": "manual",
         "localizations": {
            "ar": {
               "stringUnit": {
                  "state": "translated",
                  "value": "وضع الحزمة"
               }
            },
            "id": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Mode Bundel"
               }
            },
            "en": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Bundle Mode"
               }
            }
         }
      },
      "bundleModeDesc": {
         "extractionState": "manual",
         "localizations": {
            "ar": {
               "stringUnit": {
                  "state": "translated",
                  "value": "استخدم قاعدة البيانات المدمجة في التطبيق (للقراءة فقط). بالنسبة للمكتبة الكاملة، قم بتعطيل هذا واختر مجلدا مخصصا."
               }
            },
            "id": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Gunakan basis data bawaan aplikasi (hanya baca). Untuk Perpustakaan Lengkap, nonaktifkan ini dan pilih folder khusus."
               }
            },
            "en": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Use the app's built-in database (read-only). For the Full Library, disable this and choose a custom folder."
               }
            }
         }
      },
      "checkAtStart": {
         "extractionState": "manual",
         "localizations": {
