{
   "sourceLanguage": "en",
   "strings": {
      "annotationMoveFolderFileExistsTitle": {
         "extractionState": "manual",
         "localizations": {
            "ar": {
               "stringUnit": {
                  "state": "translated",
                  "value": "تم العثور على التعليقات التوضيحية الحالية"
               }
            },
            "en": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Existing Annotations Found"
               }
            },
            "id": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Anotasi Yang Ada Ditemukan"
               }
            }
         }
      },
      "annotationsAndSearchResults": {
         "extractionState": "manual",
         "localizations": {
            "ar": {
               "stringUnit": {
                  "state": "translated",
                  "value": "التعليقات ونتائج البحث"
               }
            },
            "id": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Anotasi & Hasil Pencarian"
               }
            },
            "en": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Annotations & Search Results"
               }
            }
         }
      },
      "annotationsMoveFolderFileExistsDesc": {
         "extractionState": "manual",
         "localizations": {
            "ar": {
               "stringUnit": {
                  "state": "translated",
                  "value": "التعليقات التوضيحية موجودة بالفعل في مجلد الوجهة. هل ترغب في الاحتفاظ بها (وحذف القديمة) أو الكتابة فوقها بالقديمة؟"
               }
            },
            "en": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Annotations already exist in the destination folder. Would you like to keep them (and delete the old ones) or overwrite them with the old ones?"
               }
            },
            "id": {
               "stringUnit": {
                  "state": "translated",
                  "value": "Anotasi sudah ada di folder tujuan. Apakah Anda ingin menggunakan anotasi di folder tujuan (dan menghapus yang lama) atau menimpa anotasi di folder tujuan dengan yang lama?"
               }
            }
         }
      },
